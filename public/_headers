# Cache policy for Cloudflare Pages (Netlify reads the same file).

# Vite fingerprints these, so the name changes whenever the bytes do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Portraits are requested as <id>.webp?v=<hash of the bytes>. Caches key on the
# query too, so a replaced portrait arrives under a URL nobody has cached.
/portraits/*
  Cache-Control: public, max-age=31536000, immutable

# The entry point names the current bundle, so it must never be held.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The preview image keeps its name when it is replaced, so hold it for a day.
/og.jpg
  Cache-Control: public, max-age=86400

# Applied to every response. The page itself loads nothing from another origin.
# The two Cloudflare hosts are there for Web Analytics: the beacon is served from
# static.cloudflareinsights.com and posts to cloudflareinsights.com. Drop both
# names if the analytics toggle in the Pages project is ever turned off.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
