# Cache policy for Cloudflare Pages (Netlify reads the same file).

# Vite fingerprints these, so the name changes whenever the bytes do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Portraits are requested as <id>.webp?v=<hash of the bytes>. Caches key on the
# query too, so a replaced portrait arrives under a URL nobody has cached.
/portraits/*
  Cache-Control: public, max-age=31536000, immutable

# The entry point names the current bundle, so it must never be held.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
