# Cache policy for Cloudflare Pages (Netlify reads the same file).

# Vite fingerprints these, so the name changes whenever the bytes do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Portraits keep a stable name across re-runs of scripts/fetch-portraits.mjs,
# so they cannot be immutable: a corrected face has to be able to reach people
# who already have the wrong one. A week, served stale for a day while the
# replacement downloads in the background.
/portraits/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The entry point names the current bundle, so it must never be held.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
